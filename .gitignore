# CIF (Crawl, Identify, Fix): files git must never track.
# Rule of thumb: secrets, generated files, and anything that can be rebuilt.

# ---- Secrets ---------------------------------------------------------------
# Real keys (e.g. GEMINI_API_KEY) live only in .env. The template is tracked.
.env
.env.*
!.env.example
*.pem
*.key

# ---- Python ----------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
build/

# ---- Node / frontend -------------------------------------------------------
node_modules/
dist/
*.tsbuildinfo
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Playwright ------------------------------------------------------------
# Browsers themselves install to %LOCALAPPDATA%\ms-playwright (outside the repo).
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ---- Runtime data: databases, LLM response cache ---------------------------
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ---- Evaluation ------------------------------------------------------------
# Summaries (summary.json / summary.md) ARE tracked so README numbers are
# traceable; bulky raw per-run outputs are not.
eval/results/**/raw/

# ---- Logs ------------------------------------------------------------------
*.log
logs/

# ---- Deployment ------------------------------------------------------------
.vercel/

# ---- Private working notes -------------------------------------------------
# The step-by-step project plan stays local; the public design doc does not.
docs/PLAN.md
docs/PLAN.pdf

# ---- OS / editor -----------------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store
.idea/
.vscode/
